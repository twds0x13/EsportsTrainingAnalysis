# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# and https://github.com/github/gitignore/blob/main/VisualStudio.gitignore.
# Unity rules are scoped to the client project because this file is at the
# repository root and the Unity project lives in src/client/.
/src/client/[Ll]ibrary/
/src/client/[Tt]emp/
/src/client/[Oo]bj/
